<script>
    var allflights = null;

    const formatString = (template, ...args) => {
        return template.replace(/{([0-9]+)}/g, function (match, index) {
            return typeof args[index] === 'undefined' ? match : args[index];
        });
    }

    $(document).ready(function () {
        loadFlights(20);

        setInterval(
            function () {
                var currentNb = $("#flightsList tr").length;
                loadFlights(currentNb);
                //console.log(' >> window.AirportAI >> ', window.AirportAI)
                if (window.AirportAI && window.AirportAI.renderPlugins) {
                    window.AirportAI.renderPlugins();
                }
            },
            2 * 60 * 1000
        );
    });
        
    function loadFlights(nb) {
        var alldatas = {};
        var datas = {};
        datas["Type"] = 'DEPARTURE';
        datas["City"] = GetURLParameter("city");
        datas["FlightNumber"] = GetURLParameter("number");
        datas["Date"] = GetURLParameter("date");
        datas["Hour"] = GetURLParameter("hour");
        datas["Airline"] = GetURLParameter("airline");
        datas["Culture"] = 'en-GB';
        datas["Search"] = GetURLParameter("search");
        alldatas.datas = JSON.stringify(datas);

        // Manage new version of the HomePage
        var urlToCall = '';
        if (datas["Search"] !== undefined && datas["Search"].length > 0) {

            urlToCall = '/api/v1/data/searchFAC';
        }
        else { 
            urlToCall = '/api/v1/data/flights'
        }

        // Call dedicated method
        $.ajax({
            url: urlToCall,
            context: document.body,
            contentType: 'application/json',
            dataType: 'json',
            method: 'POST',
            data: JSON.stringify(alldatas),
            success: function (data) {
                if (!data)
                    return;
                allflights = data;
                $(".moreflights").show();
                displayFlights(nb);
                if (!allflights || allflights.length <= 20) {
                    $(".moreflights").hide();
                }
            }
        });
    }

    function displayFlights(nb) {
        var flightsList = $("#flightsList");
        flightsList.empty();
        $(".infovol-mention-update").empty();
        if (allflights && allflights.length > 0) {
            $.each(allflights.slice(0, nb), function (index, flight) {
                if (flight == null || flight == undefined)
                    return;
                var id = flight.FlightAoId;
                if (index == 0) {
                    var last = formatString("Last update on {0} at {1}", flight.LastKenticoUpdate.split(' ')[0], flight.LastKenticoUpdate.split(' ')[1]);
                    $(".infovol-mention-update").append(last);
                }
                flightsList.append('<tr class="table-tr-flights" data-href="' + ((flight.Type === "DEPARTURE") ? "/en/Site/Passagers/Vols/Informations/Departs/Info-vol-detaillee" : "/en/Site/Passagers/Vols/Informations/Arrivees/Info-vol-detaillee") + '?id=' + id + '">' +
                    '<td><span>' + ((flight.Type === "DEPARTURE") ? flight.DepartureScheduledTime : flight.ArrivalScheduledTime) + '</span><br /><span class="hide-for-large ' + ((flight.IsLate) ? 'infovol-delayed' : '') + '" aria-hidden="true">' + ((flight.Type === "DEPARTURE") ? flight.DepartureExpectedTime : flight.ArrivalExpectedTime) + '</span></td>' +
                    '<td class="show-for-large '+((flight.IsLate) ? "infovol-delayed" : '')+'">' + ((flight.Type === "DEPARTURE") ? flight.DepartureExpectedTime : flight.ArrivalExpectedTime) + '</td>' +
                    '<td class="show-for-medium"><span>' + ((flight.Type === "DEPARTURE") ? flight.Destination : flight.Departure) + '</span>' +
                    ((flight.ViaShort != '') ? '<span class="infovol-small"> VIA ' + flight.ViaShort + '</span>' : '') +
                    '</td>' +
                    '<td class="show-for-large">' + flight.Airline + '</td>' +
                    '<td class="show-for-medium">' + flight.Name + '</td>' +
                    '<td class="show-for-small-only"><span>' + ((flight.Type === "DEPARTURE") ? flight.Destination : flight.Departure)  +'</span>' + '</br>'+  '<span class="flightName">' +flight.Name + '</span>' + '</td>' +
                    '<td class="infovol-' + flight.StatusClass + '">' + flight.Status + '</td>' +
                    '<td class="show-for-large">' + ((flight.Delay > 0) ? "<span>" + zeroPad(flight.Delay, 4).substr(0, 2) + 'h' + zeroPad(flight.Delay, 4).substr(2) + "</span>" : '') + '</td>' +
                    '<td class="show-for-medium"><a aria-label="Voir les détails du vol" href="' + ((flight.Type === "DEPARTURE") ? "/en/Site/Passagers/Vols/Informations/Departs/Info-vol-detaillee" : "/en/Site/Passagers/Vols/Informations/Arrivees/Info-vol-detaillee") + '?id=' + id + '"><span aria-hidden class="fas fa-eye flight-details-action" alt="See flight details"></span></a></td>' +
                    '<td><div class="airportAI-notificationsPlugin" flightType="' + flight.Type + '" flightCode="' + flight.Name + '" flightDate="' + flight.DepartureScheduledDate.split(".").join("-") + '" pluginSingle="FALSE" referral=DEPARTURES_PAGE></div></td>' + 
                    '</tr>');
            });
            window.initDataHref();
        }
        else {
            $('th.selecteddate').addClass("hide");
            $('th.no-result').removeClass("hide");
        }

        if (window.AirportAI) {
            window.AirportAI.renderPlugins();
        }
    }

    function zeroPad(num, places) {
        var zero = places - num.toString().length + 1;
        return Array(+(zero > 0 && zero)).join("0") + num;
    }

    function showMore() {
        var oldnb = $("#flightsList tr").length;
        if (!allflights || allflights.length < oldnb + 20) {
            $(".moreflights").hide();
        }
        displayFlights(oldnb + 20);
    }

    function GetURLParameter(elem) {
        var sPageURL = window.location.search.substring(1);
        var sURLVariables = sPageURL.split('&');
        for (var i = 0; i < sURLVariables.length; i++) {
            var sParameterName = sURLVariables[i].split('=');
            if (sParameterName[0] == elem) {
                return decodeURIComponent(sParameterName[1]);
            }
        }
    }

</script>

